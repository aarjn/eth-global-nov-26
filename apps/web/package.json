{
  "name": "@paisalink/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "embed": "bun build ../../packages/widget/src/embed.ts --outfile public/embed.js --minify --target browser",
    "dev": "bun run embed && bun node_modules/vite/bin/vite.js --host",
    "build": "bun run embed && bun node_modules/vite/bin/vite.js build",
    "preview": "bun node_modules/vite/bin/vite.js preview --host",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit -p .",
    "test": "bun test"
  },
  "dependencies": {
    "@paisalink/react": "workspace:*",
    "@paisalink/shared": "workspace:*",
    "@worldcoin/idkit": "4.6.0",
    "@worldcoin/idkit-core": "4.6.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
